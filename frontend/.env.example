# Copy to .env.local after deploying IdentityAccessManager.
# Leave the contract address empty until a real deployment exists.
VITE_CONTRACT_ADDRESS=
# Optional: set this to the deployed chain ID to detect the wrong network.
VITE_CHAIN_ID=
# Optional: block number of deployment for event history scans.
VITE_DEPLOYMENT_BLOCK=0
# Optional transaction explorer prefix, e.g. https://sepolia.etherscan.io/tx
VITE_BLOCK_EXPLORER_TX_URL=